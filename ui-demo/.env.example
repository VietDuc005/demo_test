# Chọn provider: auto (ưu tiên OpenRouter), openrouter hoặc gemini
MODEL_PROVIDER=auto

# Chỉ cần cấu hình một trong hai key. Không đưa key sang frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Tuỳ chọn: gửi email thật. Nếu bỏ trống, reminder chạy ở chế độ mô phỏng có audit log.
RESEND_API_KEY=
MAIL_FROM=AutoAdvisor <booking@example.com>

PORT=8080
